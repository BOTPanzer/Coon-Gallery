<resources>
    <style name="Theme.TurboPhotos" parent="Theme.Material3Expressive.Light.NoActionBar">
        <!-- Status bar color -->
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Navigation bar color -->
        <item name="android:navigationBarColor">?attr/colorSurface</item>

        <!-- Modals -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.TurboPhotos.AlertDialog</item>

        <!-- Default font -->
        <item name="android:fontFamily">@font/outfit</item>
    </style>

    <!-- Modals -->
    <style name="Widget.TurboPhotos.AlertDialog.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">@font/fraunces</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="TextAppearance.TurboPhotos.Dialog.Content" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="ThemeOverlay.TurboPhotos.AlertDialog" parent="ThemeOverlay.Material3Expressive.MaterialAlertDialog">
        <item name="materialAlertDialogTitleTextStyle">@style/Widget.TurboPhotos.AlertDialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.TurboPhotos.Dialog.Content</item>
        <item name="android:background">?attr/colorSurfaceContainerLow</item>
    </style>
</resources>
